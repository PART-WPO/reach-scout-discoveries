  "body": "\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"utf-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Cb-WoFS - Home</title>\n    <link rel=\"stylesheet\" href=\"/css/site.min.css\" />\n    <script src=\"/js/libs/jquery.min.js\"></script>\n    <script src=\"/js/libs/bootstrap.bundle.min.js\"></script>\n    <script>\n        fetch('/Home/Menu')\n          .then(async resp => {\n            if (resp.ok) {\n              document.getElementById('menu_container').innerHTML = await resp.text();\n            }\n          })\n          .catch(error => {\n            console.error('There was a problem with the fetch operation:', error);\n          });\n    </script>\n        <script async type=\"text/javascript\" id=\"_fed_an_ua_tag\" src=\"https://dap.digitalgov.gov/Universal-Federated-Analytics-Min.js?agency=DOC&amp;subagency=NOAA&amp;sitetopic=weather&amp;exts=kmz,json,csv&amp;yt=true&amp;sdor=nssl.noaa.gov&amp;dclink=true&amp;enhlink=true\"></script>\n</head>\n<body>\n    <header>\n        <nav class=\"navbar navbar-expand-lg navbar-toggleable-lg navbar-light border-bottom box-shadow\">\n            <div class=\"container\">\n                <a class=\"navbar-brand\" href=\"/\">\n                    <img src=\"/img/logo.png\" class=\"logo-image\" />\n                    <div class=\"logo-text\">\n                        <span class=\"text-muted\">cloud-based</span>\n                        <span>WoFS</span>\n                    </div>\n                </a>\n                <button class=\"navbar-toggler\" type=\"button\" data-bs-toggle=\"collapse\" data-bs-target=\".navbar-collapse\" aria-controls=\"navbarSupportedContent\"\n                        aria-expanded=\"false\" aria-label=\"Toggle navigation\">\n                    <span class=\"navbar-toggler-icon\"></span>\n                </button>\n                <div class=\"navbar-collapse collapse\" id=\"menu_container\">\n                    <ul class=\"navbar-nav flex-grow-1\">\n                        <li class=\"nav-item\">\n                            <a class=\"nav-link text-dark\" href=\"/Forecast\">Forecasts</a>\n                        </li>\n                    </ul>\n                    <ul class=\"navbar-nav\">\n                        <li class=\"nav-item\">\n                            <a class=\"nav-link text-dark\" href=\"/Account/Login?redirectUri=%2F\">Login</a>\n                        </li>\n                    </ul>\n                </div>\n            </div>\n        </nav>\n    </header>\n    <main role=\"main\" class=\"pb-5\">\n        \n\n<div id=\"homeCarousel\" class=\"carousel slide mb-3\" data-bs-ride=\"carousel\">\n    <div class=\"carousel-indicators\">\n        <button type=\"button\" data-bs-target=\"#homeCarousel\" data-bs-slide-to=\"0\" class=\"active\" aria-current=\"true\" aria-label=\"Slide 1\"></button>\n        <button type=\"button\" data-bs-target=\"#homeCarousel\" data-bs-slide-to=\"1\" aria-label=\"Slide 2\"></button>\n        <button type=\"button\" data-bs-target=\"#homeCarousel\" data-bs-slide-to=\"2\" aria-label=\"Slide 3\"></button>\n    </div>\n    <div class=\"carousel-inner\">\n        <div class=\"carousel-item active\">\n            <img class=\"bd-placeholder-img\" src=\"/img/home/dow.jpg\" />\n            <div class=\"mask\"></div>\n            <div class=\"container\">\n                <div class=\"carousel-caption text-start\">\n                    <h1>Real-time Data.</h1>\n                    <p>Rapid data assimilation of surface, radar and satellite observations for the most up-to-date forecasts.</p>\n                    <p><a class=\"btn btn-lg btn-primary\" href=\"/forecast\">View forecasts</a></p>\n                </div>\n            </div>\n        </div>\n        <div class=\"carousel-item\">\n            <img class=\"bd-placeholder-img op-bottom\" src=\"/img/home/supercell.jpg\" />\n            <div class=\"mask\"></div>\n            <div class=\"container\">\n                <div class=\"carousel-caption\">\n                    <h1>History of Warn-on-Forecast.</h1>\n                    <p>Explore the history of Warn-on-Forecast, from concept to its development at NSSL.</p>\n                    <p><a class=\"btn btn-lg btn-primary\" href=\"https://www.nssl.noaa.gov/projects/wof/overview.php\" target=\"_blank\">Explore</a></p>\n                </div>\n            </div>\n        </div>\n        <div class=\"carousel-item\">\n            <img class=\"bd-placeholder-img\" src=\"/img/home/wofs5.jpg\" />\n            <div class=\"mask\"></div>\n            <div class=\"container\">\n                <div class=\"carousel-caption text-end\">\n                    <h1>Cb-WoFS: Migrating the Warn-on-Forecast System to the Cloud</h1>\n                    <p>Read more about the cloud-based Warn-on-Forecast design and development from our recent AMS publication.</p>\n                    <p><a class=\"btn btn-lg btn-primary\" href=\"https://journals.ametsoc.org/view/journals/bams/105/10/BAMS-D-23-0296.1.xml?rskey=Wp7OCi&result=1\" target=\"_blank\">Learn more</a></p>\n                </div>\n            </div>\n        </div>\n    </div>\n    <button class=\"carousel-control-prev\" type=\"button\" data-bs-target=\"#homeCarousel\" data-bs-slide=\"prev\">\n        <span class=\"carousel-control-prev-icon\" aria-hidden=\"true\"></span>\n        <span class=\"visually-hidden\">Previous</span>\n    </button>\n    <button class=\"carousel-control-next\" type=\"button\" data-bs-target=\"#homeCarousel\" data-bs-slide=\"next\">\n        <span class=\"carousel-control-next-icon\" aria-hidden=\"true\"></span>\n        <span class=\"visually-hidden\">Next</span>\n    </button>\n</div>\n\n<div class=\"container home-columns\">\n    <div class=\"row\">\n        <div class=\"col-lg-4\">\n            <img src=\"/img/home/map.png\" class=\"circle\" width=\"140\" height=\"140\" />\n            <h2 class=\"fw-normal\">Real-time Forecasts</h2>\n            <p>View forecast data in real-time as model output is processed and posted to the web.</p>\n            <p><a class=\"btn btn-secondary\" href=\"/forecast\">Forecasts &raquo;</a></p>\n        </div>\n        <div class=\"col-lg-4\">\n            <img src=\"/img/home/wofs3.jpg\" class=\"circle\" width=\"140\" height=\"140\" />\n            <h2 class=\"fw-normal\">About WoFS</h2>\n            <p>Warn-on-Forecast provides probabilistic hazard guidance generated by an ensemble of forecasts from convection-resolving numerical weather prediction models.</p>\n            <p><a class=\"btn btn-secondary\" href=\"https://www.nssl.noaa.gov/projects/wof/\" target=\"_blank\">Learn more &raquo;</a></p>\n        </div>\n        <div class=\"col-lg-4\">\n            <img src=\"/img/home/pub.jpg\" class=\"circle\" width=\"140\" height=\"140\" />\n            <h2 class=\"fw-normal\">Publications</h2>\n            <p>Browse the NSSL database for Warn-on-Forecast research publications.</p>\n            <p><a class=\"btn btn-secondary\" href=\"https://nssl.noaa.gov/publications/listings.php\" target=\"_blank\">Search &raquo;</a></p>\n        </div>\n    </div>\n</div>\n    </main>\n    <footer class=\"border-top footer text-muted\">\n        <div class=\"container\">\n            &copy; 2026 - CIWRO / NSSL Cloud-based Warn-on-Forecast\n        </div>\n    </footer>\n    \n    <script async src=\"https://www.googletagmanager.com/gtag/js?id=G-XMS906ZHSK\"></script>\n    <script>\n    window.dataLayer = window.dataLayer || [];\n    function gtag() { dataLayer.push(arguments); }\n    gtag('js', new Date());\n    gtag('config', 'G-XMS906ZHSK');\n    </script>\n</body>\n</html>\n"
}
