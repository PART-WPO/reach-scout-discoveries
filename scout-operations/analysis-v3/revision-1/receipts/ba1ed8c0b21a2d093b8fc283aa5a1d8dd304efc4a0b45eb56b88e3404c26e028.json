 src=\"/assets/scripts/article-downloads.pack.js\"></script>\n<script type=\"text/javascript\">\n    insertDownloads(27375539);\n</script>\n\n\n<!-- Add border to Plum badge & download counts when visible -->\n<script>\n// bind to event when PlumX widget loads\nwidget.addEventListener('plumx:load', (event) => {\n  jQuery('#article-stats').removeClass('hidden');\n  jQuery('.article-stats-date').addClass('plum-border');\n});\n\n// bind to event when page loads\njQuery(window).on('load',function(e){\n// if DC downloads are visible\n  if (jQuery('#article-downloads').text().length > 0) {\n// add border to aside\n  jQuery('#article-stats').removeClass('hidden');\n  }\n});\n</script>\n\n\n\n<!-- Adobe Analytics: Download Click Tracker -->\n<script>\n\n$(function() {\n\n  // Download button click event tracker for PDFs\n  $(\".aside.download-button\").on(\"click\", \"a#pdf\", function(event) {\n    pageDataTracker.trackEvent('navigationClick', {\n      link: {\n          location: 'aside download-button',\n          name: 'pdf'\n      }\n    });\n  });\n\n  // Download button click event tracker for native files\n  $(\".aside.download-button\").on(\"click\", \"a#native\", function(event) {\n    pageDataTracker.trackEvent('navigationClick', {\n        link: {\n            location: 'aside download-button',\n            name: 'native'\n        }\n     });\n  });\n\n});\n\n</script>\n<!-- FILE: /srv/sequoia/main/data/assets/site/info_box_7_3.inc (cont) -->\n\n\n\n\t<!-- FILE: /srv/sequoia/main/data/assets/site/info_box_disciplines.inc -->\n\n\n\n\n\t\n\n\n\n\n\n\t<div id=\"beta-disciplines\" class=\"aside\">\n\t\t<h3>Included in</h3>\n\t<p>\n\t\t\n\t\t\t\t\n\t\t\t\t\n\t\t\t\t\t<a href=\"https://network.bepress.com/hgg/discipline/187\" title=\"Atmospheric Sciences Commons\" >Atmospheric Sciences Commons</a>, \n\t\t\t\t\n\t\t\t\n\t\t\n\t\t\t\t\n\t\t\t\t\t<a href=\"https://network.bepress.com/hgg/discipline/153\" title=\"Earth Sciences Commons\" >Earth Sciences Commons</a>\n\t\t